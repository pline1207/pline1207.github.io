class nnUNetTrainerVxMA_a(nnUNetTrainer):
    def __init__(
        self,
        plans: dict,
        configuration: str,
        fold: int,
        dataset_json: dict,
        unpack_dataset: bool = True,
        device: torch.device = torch.device("cuda"), 
        verbose = False,
    ):
        super().__init__(plans, configuration, fold, dataset_json, unpack_dataset, device, verbose)
        self.enable_deep_supervision = False
        

    @staticmethod
    def build_network_architecture(architecture_class_name: str,
                                   arch_init_kwargs: dict,
                                   arch_init_kwargs_req_import: Union[List[str], Tuple[str, ...]],
                                   num_input_channels: int,
                                   num_output_channels: int,
                                   enable_deep_supervision: bool = True,
                                   verbose: bool = False,
                                   ) -> nn.Module:

        # TODO: 모델 구조 변경

        # vxm unet architecture
        # enc_nf = arch_init_kwargs['arch_init_kwargs'] if arch_init_kwargs['arch_init_kwargs'] else [16, 32, 32, 32]
        # dec_nf = reversed(arch_init_kwargs['arch_init_kwargs']) if arch_init_kwargs['arch_init_kwargs'] else [32, 32, 32, 32, 32, 16, 16]
        enc_nf = [16, 32, 32, 32]  # encoder
        dec_nf = [32, 32, 32, 32, 32, 16, 16]  # decoder

        inshape = [192, 160] # have to be changed (MET: [192, 160], Hippocampus: [dataset 참고])
        bidir = False
        int_steps=7
        int_downsize=2

        vxm_dense = vxm.networks.VxmDense(
        inshape=inshape,
        nb_unet_features=[enc_nf, dec_nf],
        bidir=bidir,
        int_steps=int_steps,
        int_downsize=int_downsize,
        src_feats = 4, # have to be changed (MET: 4, Hippocampus: 1)
        trg_feats = 0
        )

        # Define the attention layer (tune hidden_dim as needed)
        # att params
        att_inshape = [i//2 for i in inshape]
        patch_size = 16  # Patch size
        in_chan = len(inshape)  # Number of input channels
        attention_layer = Attention(att_inshape, patch_size, in_chan=in_chan)

        network_from_plans = get_network_from_plans(
            architecture_class_name,
            arch_init_kwargs,
            arch_init_kwargs_req_import,
            num_input_channels,
            num_output_channels,
            allow_init=True,
            deep_supervision=enable_deep_supervision)
        
        # Initialize the combined network
        combined_network = CombinedNetwork(vxm_dense, attention_layer, network_from_plans, verbose)

        return combined_network
    

    def save_checkpoint(self, filename: str) -> None:
        if self.local_rank == 0:
            if not self.disable_checkpointing:
                if self.is_ddp:
                    mod = self.network.module
                else:
                    mod = self.network
                if isinstance(mod, OptimizedModule):
                    mod = mod._orig_mod

                checkpoint = {
                    'network_weights': mod.state_dict(),
                    'optimizer_state': self.optimizer.state_dict(),
                    'grad_scaler_state': self.grad_scaler.state_dict() if self.grad_scaler is not None else None,
                    'logging': self.logger.get_checkpoint(),
                    '_best_ema': self._best_ema,
                    'current_epoch': self.current_epoch + 1,
                    'init_args': self.my_init_kwargs,
                    'trainer_name': self.__class__.__name__,
                    'inference_allowed_mirroring_axes': self.inference_allowed_mirroring_axes,
                }
                torch.save(checkpoint, filename)
                if self.verbose:
                    self.save_intermediate_images(os.path.join(self.output_folder, "intermediate_images"))
            else:
                self.print_to_log_file('No checkpoint written, checkpointing is disabled')
    
    def save_intermediate_images(self, output_folder = None):
        input, transposed_input, pos_flow, transposed_output, final_output, attention = self.network.get_intermediate_images()
        target = self.target

        # Assuming self.output_folder is where you want to save the images
        if output_folder == None:
            output_folder = os.path.join(self.output_folder, "intermediate_images")
        
        os.makedirs(output_folder, exist_ok=True)

        # Save input image
        input_image = input[0].cpu()  # Assuming input is on GPU, move it to CPU for saving
        save_image(input_image, os.path.join(output_folder, f'epoch_{self.current_epoch}_input.png'))

        # Save transposed input image
        transposed_input_image = transposed_input[0].cpu()  # Assuming transposed input is on GPU, move it to CPU for saving
        save_image(transposed_input_image, os.path.join(output_folder, f'epoch_{self.current_epoch}_input_trans.png'))
        
        # Save pos_flow image
        pos_flow_image = pos_flow[0].cpu()  # Assuming pos_flow is on GPU, move it to CPU for saving
        # save_image(pos_flow_image, os.path.join(output_folder, f'epoch_{self.current_epoch}_pos_flow.png'))
        save_image(pos_flow_image[0], os.path.join(output_folder, f'epoch_{self.current_epoch}_pos_flow_y.png'))
        save_image(pos_flow_image[1], os.path.join(output_folder, f'epoch_{self.current_epoch}_pos_flow_x.png'))
        
        # Save transposed_output_image image
        transposed_output_image = transposed_output[0].cpu()  # Assuming transposed_output is on GPU, move it to CPU for saving
        save_image(transposed_output_image, os.path.join(output_folder, f'epoch_{self.current_epoch}_output_trans.png'))
        
        # Save final_output image
        final_output_image = final_output[0].cpu()  # Assuming final_output is on GPU, move it to CPU for saving
        save_image(final_output_image, os.path.join(output_folder, f'epoch_{self.current_epoch}_output_final.png'))
        
        # Save target image
        target_image = target[0].cpu()  # Assuming target is on GPU, move it to CPU for saving
        save_image(target_image, os.path.join(output_folder, f'epoch_{self.current_epoch}_target.png'))
        
        # Save attention image
        attention_image = attention[0].cpu()  # Assuming attention is on GPU, move it to CPU for saving
        save_image(attention_image, os.path.join(output_folder, f'epoch_{self.current_epoch}_attention.png'))

    def _build_loss(self):
        original_loss = super()._build_loss()
        weights = [1, 0.2]
        grad_loss = vxm.losses.Grad('l2').loss

        loss = lambda x, y: weights[0] * original_loss(x, y) + weights[1] * grad_loss(x, y)
        return loss
    
