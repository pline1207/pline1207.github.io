class CombinedNetwork(nn.Module):
    def __init__(self, vxm_dense, attention_network, network_from_plans, verbose = False):
        super(CombinedNetwork, self).__init__()

        # Dynamically copy all attributes from network_from_plans to CombinedNetwork
        # 스택 너무많이 쌓였다 오류 나서 없앰, 필요한것만 따로 선언하자.
        # for attr_name in dir(network_from_plans):
        #     attr_value = getattr(network_from_plans, attr_name)
        #     if not attr_name.startswith("_") and not callable(attr_value): # not attr_name.startswith("__")
        #         setattr(self, attr_name, attr_value)
        self.vxm_dense = vxm_dense
        self.attention_network = attention_network
        self.network_from_plans = network_from_plans
        
        self.decoder = network_from_plans.decoder

        self.verbose = verbose

        self.y_source = self.pos_flow = self.predicted_output = self.final_output = None
        
        # # 채널수 조정
        # vxm_output_channels = vxm_dense.unet_model.final_nf  # Output channels from VxmDense
        # network_input_channels = self._get_first_layer_input_channels(network_from_plans)
        
        # if vxm_output_channels != network_input_channels:
        #     self.channel_adjust = nn.Conv2d(vxm_output_channels, network_input_channels, kernel_size=1)
        # else:
        #     self.channel_adjust = nn.Identity()

    def forward(self, source):
        # Pass the source through VxmDense
        vxm_output = self.vxm_dense(source, registration=False)

        # vxm_output is a tuple (y_source, pos_flow) when registration=True
        y_source, pos_flow = vxm_output # pos_flow로 transform된 y_source

        # Apply attention to the pos_flow
        multihead_image, attention = self.attention_network(pos_flow)
        normalized_attention = (multihead_image - torch.min(multihead_image)) / (torch.max(multihead_image) - torch.min(multihead_image))
        # pos_flow의 절대값에 multihead_image를 더함
        modified_pos_flow = torch.abs(pos_flow) + multihead_image

        # 기존 pos_flow의 부호 저장
        sign_pos_flow = torch.sign(pos_flow)

        # 추가 후 음수로 변한 값을 부호 반대로 변경
        attended_pos_flow = modified_pos_flow * sign_pos_flow

        attended_pos_flow = self.vxm_dense.fullsize(attended_pos_flow)

        # Use the attended flow to deform the source image
        deformed_source=self.vxm_dense.transformer(source, attended_pos_flow)

        # Pass the output of VxmDense through the other network
        if isinstance(deformed_source, tuple):
            deformed_source = deformed_source[0]
        predicted_output = self.network_from_plans(deformed_source)

        # 아마 여기에 flow로 되돌리는 코드 넣어야 할지도
        neg_flow = -attended_pos_flow
        final_output = self.vxm_dense.transformer(predicted_output, neg_flow)

        if self.verbose:
            self.source = source
            self.y_source = deformed_source
            self.pos_flow = attended_pos_flow
            self.deformed_output = predicted_output
            self.predicted_output = predicted_output
            self.final_output = final_output
            self.attention = multihead_image
            # self.save_intermediate_images(y_source, pos_flow, predicted_output, final_output)
        return final_output

    def get_intermediate_images(self):
        # source, deformed_source, pos_flow, deformed_output, final_output
        return self.source, self.y_source, self.pos_flow, self.deformed_output, self.final_output, self.attention

